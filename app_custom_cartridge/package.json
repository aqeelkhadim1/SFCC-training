{
  "name": "app_custom_cartridge",
  "version": "1.0.0",
  "description": "Custom cartridge for SFCC customer registration enhancements",
  "main": "index.js",
  "packageName": "app_custom_cartridge",
  "workspaces": [
    "cartridges/form_custom_cartridge",
    "cartridges/mycartridge"
  ],
  "paths": {
    "base": "../storefront-reference-architecture-master/cartridges/app_storefront_base"
  },
  "scripts": {
    "compile:js": "node ../storefront-reference-architecture-master/node_modules/sgmf-scripts/index.js --compile js",
    "compile:scss": "node ../storefront-reference-architecture-master/node_modules/sgmf-scripts/index.js --compile css",
    "build:app_custom_cartridge": "npm run compile:js && npm run compile:scss",
    "build:mycartridge": "npm --prefix cartridges/mycartridge run build",
    "build:form_custom_cartridge": "npm --prefix cartridges/form_custom_cartridge run build",
    "build": "npm run build:app_custom_cartridge && npm run build:mycartridge && npm run build:form_custom_cartridge",
    "watch:app_custom_cartridge": "node ../storefront-reference-architecture-master/node_modules/sgmf-scripts/index.js --watch",
    "watch": "node scripts/watch.js"
  },
  "devDependencies": {
    "@babel/core": "^7.6.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.6.2",
    "@babel/preset-env": "^7.6.3",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^8.0.6",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss-loader": "^8.1.1",
    "sass": "^1.77.2",
    "sass-loader": "^14.2.1",
    "sgmf-scripts": "^3.1.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-remove-empty-scripts": "^1.0.4"
  }
}
