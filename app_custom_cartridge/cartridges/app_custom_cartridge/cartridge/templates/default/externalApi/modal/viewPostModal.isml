<div class="modal fade" id="viewPostModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">${Resource.msg('modal.view.title', 'externalApi', null)}</h5>
                <button type="button" class="btn-close close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="${Resource.msg('btn.close', 'externalApi', null)}"></button>
            </div>

            <div class="modal-body">
                <p><strong>${Resource.msg('th.id', 'externalApi', null)}:</strong> <span id="view-id"></span></p>
                <p><strong>${Resource.msg('label.userid', 'externalApi', null)}:</strong> <span id="view-userId"></span></p>
                <p><strong>${Resource.msg('label.title', 'externalApi', null)}:</strong> <span id="view-title"></span></p>
                <p><strong>${Resource.msg('label.description', 'externalApi', null)}:</strong> <span id="view-body"></span></p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">
                    ${Resource.msg('btn.cancel', 'externalApi', null)}
                </button>
            </div>
        </div>
    </div>
</div>
