<div class="modal fade" id="editPostModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="edit-form" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title">${Resource.msg('modal.edit.title', 'externalApi', null)}</h5>
                    <button type="button" class="btn-close close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="${Resource.msg('btn.close', 'externalApi', null)}"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id">

                    <div class="form-group mb-3">
                        <label class="form-label">${Resource.msg('label.userid', 'externalApi', null)} <span class="text-danger" aria-hidden="true">${Resource.msg('symbol.required', 'externalApi', null)}</span></label>
                        <input type="number" name="userId" class="form-control">
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">${Resource.msg('label.title', 'externalApi', null)} <span class="text-danger" aria-hidden="true">${Resource.msg('symbol.required', 'externalApi', null)}</span></label>
                        <input type="text" name="title" class="form-control">
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">${Resource.msg('label.description', 'externalApi', null)} <span class="text-danger" aria-hidden="true">${Resource.msg('symbol.required', 'externalApi', null)}</span></label>
                        <textarea name="body" class="form-control" rows="4"></textarea>
                        <div class="invalid-feedback"></div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">
                        ${Resource.msg('btn.cancel', 'externalApi', null)}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        ${Resource.msg('modal.edit.btn.update', 'externalApi', null)}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
