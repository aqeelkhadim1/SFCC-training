<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/externalApi.css');
        assets.addJs('/js/externalApi.js');
    </isscript>

    <div class="container my-4">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
            <div>
                <h1>${Resource.msg('title.viewmore.management', 'externalApi', null)}</h1>
                <p class="text-muted mb-0">${Resource.msg('subtitle.viewmore.management', 'externalApi', null)}</p>
            </div>

            <div class="mt-2 mt-md-0">
                <a href="${URLUtils.url('ExternalApi-Show')}" class="btn btn-outline-secondary me-2">
                    <i class="fa fa-arrow-left me-1" aria-hidden="true"></i> ${Resource.msg('link.back.to.management', 'externalApi', null)}
                </a>
                <button type="button" class="btn btn-primary js-create-post">
                    ${Resource.msg('btn.create.post', 'externalApi', null)}
                </button>
            </div>
        </div>

        <div id="api-alert-container">
            <isif condition="${pdict.errorMessage}">
                <div class="alert alert-danger">
                    ${pdict.errorMessage}
                </div>
            </isif>
        </div>

        <div id="posts-config" data-get-url="${URLUtils.url('ExternalApi-GetPosts')}"
            data-view-url="${URLUtils.url('ExternalApi-ViewPost')}"
            data-save-url="${URLUtils.url('ExternalApi-SavePost')}"
            data-update-url="${URLUtils.url('ExternalApi-UpdatePost')}"
            data-delete-url="${URLUtils.url('ExternalApi-DeletePost')}"
            data-restore-page="${pdict.restorePage || 1}"
            data-csrf-name="${pdict.csrf.tokenName}"
            data-csrf-token="${pdict.csrf.token}">
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    ${Resource.msg('label.showing.posts', 'externalApi', null)}
                    <strong id="loaded-count">${pdict.posts.length}</strong>
                    ${Resource.msg('label.of', 'externalApi', null)}
                    <strong id="post-count">${pdict.pagination.totalCount}</strong>
                    ${Resource.msg('label.posts', 'externalApi', null)}
                </span>
                <span class="badge badge-success">${Resource.msg('badge.live.crud', 'externalApi', null)}</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>${Resource.msg('th.id', 'externalApi', null)}</th>
                            <th>${Resource.msg('th.userid', 'externalApi', null)}</th>
                            <th>${Resource.msg('th.title', 'externalApi', null)}</th>
                            <th>${Resource.msg('th.description', 'externalApi', null)}</th>
                            <th class="actions-col">${Resource.msg('th.actions', 'externalApi', null)}</th>
                        </tr>
                    </thead>

                    <tbody id="posts-table-body">
                        <isloop items="${pdict.posts}" var="post">
                            <tr data-id="${post.id}">
                                <td>${post.id}</td>
                                <td>${post.userId}</td>
                                <td>${post.title}</td>
                                <td>${post.body}</td>
                                <td class="actions-cell">
                                    <div class="action-btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-info btn-action js-view"
                                             data-id="${post.id}"
                                             title="${Resource.msg('btn.view', 'externalApi', null)}"
                                             aria-label="${Resource.msg('btn.view', 'externalApi', null)}">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                        </button>

                                        <button type="button"
                                             class="btn btn-sm btn-outline-secondary btn-action js-edit"
                                             data-id="${post.id}"
                                             title="${Resource.msg('btn.edit', 'externalApi', null)}"
                                             aria-label="${Resource.msg('btn.edit', 'externalApi', null)}">
                                            <i class="fa fa-pencil" aria-hidden="true"></i>
                                        </button>

                                        <button type="button" class="btn btn-sm btn-outline-danger btn-action js-delete"
                                             data-id="${post.id}"
                                             title="${Resource.msg('btn.delete', 'externalApi', null)}"
                                             aria-label="${Resource.msg('btn.delete', 'externalApi', null)}">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </isloop>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-center my-4">
            <button type="button" id="btn-view-more" class="btn btn-primary btn-sm px-3 py-1 shadow-sm"
                data-next-page="2"
                data-total-pages="${pdict.pagination.totalPages}"
                data-loading-text="${Resource.msg('btn.loading', 'externalApi', null)}">
                <span>${Resource.msg('btn.view.more', 'externalApi', null)}</span>
            </button>
            <div id="all-loaded-msg" class="text-muted mt-2 d-none">
                <i class="fa fa-check-circle text-success me-1" aria-hidden="true"></i>
                ${Resource.msg('msg.all.posts.loaded', 'externalApi', null)}
            </div>
        </div>

    </div>

    <isinclude template="externalApi/modal/postModal" />

</isdecorate>
