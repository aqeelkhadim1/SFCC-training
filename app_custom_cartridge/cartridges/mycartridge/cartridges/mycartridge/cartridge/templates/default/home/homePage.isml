<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/productTile.js');
        assets.addJs('/js/recentlyViewedCarousel.js');
        assets.addCss('/css/homePage.css');
        assets.addCss('/css/recentlyViewedCarousel.css');
    </isscript>

    <div class="home-main homepage">
        <isslot id="home-main-m" description="Main home page slot." context="global" />
    </div>

    <div class="container home-categories homepage">
        <div class="row home-main-categories g-0">
            <isslot id="home-categories-m" description="Categories slots on the home page." context="global" />
        </div>
    </div>

    <div class="container home-product-tiles homepage">
        <div class="hp-product-grid" itemtype="http://schema.org/SomeProducts" itemid="#product">
            <isslot id="home-products-m" description="Product tiles on the home page." context="global" />
        </div>
    </div>

    <isif condition="${pdict.recentlyViewedProducts && pdict.recentlyViewedProducts.length > 0}">
        <section class="container recently-viewed-products homepage" aria-labelledby="recently-viewed-heading" data-recently-viewed-carousel>
            <div class="recently-viewed-header">
                <h2 id="recently-viewed-heading">Recently Viewed Products</h2>
            </div>
            <div class="recently-viewed-carousel">
                <div class="recently-viewed-viewport" data-carousel-viewport tabindex="0" aria-label="Recently viewed products">
                    <div class="recently-viewed-track">
                    <isloop items="${pdict.recentlyViewedProducts}" var="product">
                        <div class="col-6 col-sm-4 col-md-3 recently-viewed-slide">
                            <isobject object="${product.raw}" view="tile">
                                <isinclude template="product/productTile" />
                            </isobject>
                            <p class="recently-viewed-availability">${product.availabilityLabel}</p>
                            <a class="btn btn-primary recently-viewed-product-button" href="${product.urls.product}">
                                View Product
                            </a>
                        </div>
                    </isloop>
                    </div>
                </div>
                <div class="recently-viewed-controls">
                    <button class="btn btn-outline-primary recently-viewed-control" type="button" data-carousel-prev aria-label="Show previous products">&lt;</button>
                    <button class="btn btn-outline-primary recently-viewed-control" type="button" data-carousel-next aria-label="Show next products">&gt;</button>
                </div>
            </div>
        </section>
    </isif>

    <div class="homepage shop-the-style">
        <isslot id="home-product-set-m" description="Link to a Product Set." context="global" />
    </div>
    <div class="home-email-signup">
        <div class="container">
            <form role="form">
                <div class="row">
                    <div class="col-sm-5">
                        <div class="input-group">
                            <input type="text" class="form-control" name="hpEmailSignUp" placeholder="${Resource.msg('placeholdertext.form.emailsignup', 'homePage', null)}" aria-label="${Resource.msg('placeholdertext.form.emailsignup', 'homePage', null)}">
                            <button type="submit" class="btn btn-primary subscribe-email" data-href="${URLUtils.url('EmailSubscribe-Subscribe')}">${Resource.msg('button.form.emailsignup', 'homePage', null)} </button>
                        </div>
                    </div>
                    <div class="col-sm-7 email-description">${Resource.msg('description.form.emailsignup', 'homePage', null)}</div>
                </div>
            </form>
        </div>
    </div>
</isdecorate>
