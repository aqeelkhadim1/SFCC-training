<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/externalApi.css');
        assets.addJs('/js/externalApiPosts.js');
    </isscript>
    <div class="container py-4" id="external-api-app"
        data-posts-url="${pdict.postsUrl}"
        data-post-url="${pdict.postUrl}"
        data-edit-url="${pdict.editUrl}"
        data-create-url="${pdict.createUrl}"
        data-update-url="${pdict.updateUrl}"
        data-delete-url="${pdict.deleteUrl}"
        data-csrf-name="${pdict.csrf.tokenName}"
        data-csrf-token="${pdict.csrf.token}">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Posts</h1>
            <button class="btn btn-primary" id="create-post-button" type="button">Create Post</button>
        </div>

        <div id="external-api-notice" class="alert d-none" role="status" aria-live="polite"></div>
        <div id="posts-panel">
            <div id="posts-loading" class="py-3" aria-live="polite">Loading posts…</div>
            <div id="posts-error" class="alert alert-danger d-none" role="alert"></div>
            <div id="posts-empty" class="alert alert-info d-none">No posts are available.</div>
            <div class="table-responsive" id="posts-table-container">
                <table class="table table-striped">
                    <thead>
                        <tr><th>ID</th><th>User ID</th><th>Title</th><th>Description</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="posts-table-body"></tbody>
                </table>
            </div>
            <nav aria-label="Post pages" class="posts-pagination">
                <button class="btn btn-outline-secondary" id="previous-page" type="button" disabled>Previous</button>
                <span id="current-page" aria-live="polite">Page 1</span>
                <button class="btn btn-outline-secondary" id="next-page" type="button" disabled>Next</button>
            </nav>
            <div class="d-flex justify-content-center mt-3">
                <button class="btn btn-primary d-none" id="view-more-button" type="button">View More</button>
            </div>
        </div>

    </div>

    <div class="modal fade" id="post-modal" tabindex="-1" role="dialog" aria-labelledby="post-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h4" id="post-modal-title">Post Details</h2>
                </div>
                <div class="modal-body">
                    <section id="post-detail-panel" aria-labelledby="post-modal-title">
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Post ID</dt><dd class="col-sm-9" id="detail-id"></dd>
                            <dt class="col-sm-3">User ID</dt><dd class="col-sm-9" id="detail-user-id"></dd>
                            <dt class="col-sm-3">Title</dt><dd class="col-sm-9" id="detail-title"></dd>
                            <dt class="col-sm-3">Description</dt><dd class="col-sm-9" id="detail-body"></dd>
                        </dl>
                        <div class="mt-3">
                            <button class="btn btn-primary" type="button" id="detail-edit-button">Edit Post</button>
                            <button class="btn btn-secondary" type="button" id="close-post-modal-footer">Close</button>
                        </div>
                    </section>

                    <section id="post-editor-panel" class="d-none" aria-labelledby="post-modal-title">
                        <div id="post-editor-error" class="alert alert-danger d-none" role="alert"></div>
                        <form id="post-editor-form" novalidate>
                            <input type="hidden" name="postId" id="editor-post-id" />
                            <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                            <div class="mb-3">
                                <label for="editor-user-id" class="form-label">User ID</label>
                                <input id="editor-user-id" name="userId" type="number" min="1" step="1" required class="form-control" />
                                <div class="invalid-feedback">User ID must be a positive whole number.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editor-title" class="form-label">Title</label>
                                <input id="editor-title" name="title" type="text" maxlength="200" required class="form-control" />
                                <div class="invalid-feedback">Title is required.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editor-body" class="form-label">Description</label>
                                <textarea id="editor-body" name="body" rows="5" required class="form-control"></textarea>
                                <div class="invalid-feedback">Description is required.</div>
                            </div>
                            <button class="btn btn-primary" id="save-post-button" type="submit">Create Post</button>
                            <button class="btn btn-secondary" type="button" id="cancel-post-modal" data-bs-dismiss="modal">Cancel</button>
                        </form>
                    </section>

                    <section id="post-delete-panel" class="d-none" aria-labelledby="post-modal-title">
                        <p>Are you sure you want to delete this post?</p>
                        <div class="mt-3">
                            <button class="btn btn-danger" type="button" id="confirm-delete-post">Delete Post</button>
                            <button class="btn btn-secondary" type="button" id="cancel-delete-post">Cancel</button>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</isdecorate>
