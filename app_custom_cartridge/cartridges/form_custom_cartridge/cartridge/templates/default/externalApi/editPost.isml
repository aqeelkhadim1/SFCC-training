<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/externalApi.js');
        assets.addCss('/css/externalApi.css');
    </isscript>

    <div class="container my-5 external-api-container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <!--- Back Button Link --->
                <div class="mb-3">
                    <a href="${URLUtils.url('ExternalApi-Show')}" class="text-decoration-none text-secondary">
                        &lt; ${Resource.msg('link.back.to.posts', 'externalApi', null)}
                    </a>
                </div>

                <isif condition="${pdict.error}">
                    <div class="alert alert-danger shadow-sm" role="alert">
                        <h5 class="alert-heading font-weight-bold mb-1">
                            <i class="fa fa-exclamation-circle mr-2" aria-hidden="true"></i> ${Resource.msg('heading.unavailable', 'externalApi', null)}
                        </h5>
                        <p class="mb-3">${pdict.error}</p>
                        <hr>
                        <a href="${URLUtils.url('ExternalApi-Show')}" class="btn btn-outline-danger btn-sm">
                            ${Resource.msg('btn.return.listing', 'externalApi', null)}
                        </a>
                    </div>
                </isif>

                <isif condition="${pdict.post}">
                    <!--- Edit Form Card --->
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-warning text-dark py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="m-0 font-weight-bold">
                                    <i class="fa fa-pencil-square-o mr-2" aria-hidden="true"></i> ${Resource.msgf('heading.edit.post', 'externalApi', null, pdict.post.id)}
                                </h4>
                                <small class="text-dark">${Resource.msgf('subheading.edit.post', 'externalApi', null, pdict.post.id)}</small>
                            </div>
                            <span class="badge badge-dark px-2 py-1">${Resource.msgf('badge.post.id', 'externalApi', null, pdict.post.id)}</span>
                        </div>

                        <div class="card-body p-4">
                            <!--- Global Alert Message Box (AJAX Response) --->
                            <div id="form-alert-container"></div>

                            <form id="editPostForm" action="${pdict.actionUrl}" method="POST" novalidate>
                                <!--- Hidden ID field --->
                                <input type="hidden" id="postId" name="id" value="${pdict.post.id}">

                                <!--- Field 1: User ID (Number, Required) --->
                                <div class="form-group mb-3">
                                    <label for="userId" class="font-weight-bold text-dark">
                                        ${Resource.msg('label.form.userid', 'externalApi', null)} <span class="text-danger">*</span>
                                    </label>
                                    <input type="number"
                                           class="form-control"
                                           id="userId"
                                           name="userId"
                                           placeholder="${Resource.msg('placeholder.form.userid', 'externalApi', null)}"
                                           min="1"
                                           step="1"
                                           value="${pdict.post.userId}"
                                           required>
                                    <div class="invalid-feedback" id="userId-error">
                                        ${Resource.msg('error.form.userid', 'externalApi', null)}
                                    </div>
                                    <small class="form-text text-muted">${Resource.msg('help.form.userid', 'externalApi', null)}</small>
                                </div>

                                <!--- Field 2: Title (Text, Required) --->
                                <div class="form-group mb-3">
                                    <label for="title" class="font-weight-bold text-dark">
                                        ${Resource.msg('label.form.title', 'externalApi', null)} <span class="text-danger">*</span>
                                    </label>
                                    <input type="text"
                                           class="form-control"
                                           id="title"
                                           name="title"
                                           placeholder="${Resource.msg('placeholder.form.title', 'externalApi', null)}"
                                           maxlength="200"
                                           value="${pdict.post.title}"
                                           required>
                                    <div class="invalid-feedback" id="title-error">
                                        ${Resource.msg('error.form.title', 'externalApi', null)}
                                    </div>
                                </div>

                                <!--- Field 3: Description / Body (Textarea, Required) --->
                                <div class="form-group mb-4">
                                    <label for="body" class="font-weight-bold text-dark">
                                        ${Resource.msg('label.form.body', 'externalApi', null)} <span class="text-danger">*</span>
                                    </label>
                                    <textarea class="form-control"
                                              id="body"
                                              name="body"
                                              rows="5"
                                              placeholder="${Resource.msg('placeholder.form.body', 'externalApi', null)}"
                                              required>${pdict.post.body}</textarea>
                                    <div class="invalid-feedback" id="body-error">
                                        ${Resource.msg('error.form.body', 'externalApi', null)}
                                    </div>
                                </div>

                                <!--- Form Actions --->
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <a href="${URLUtils.url('ExternalApi-Show')}" class="btn btn-outline-secondary">
                                        ${Resource.msg('button.form.cancel', 'externalApi', null)}
                                    </a>
                                    <button type="submit" class="btn btn-warning px-4 font-weight-bold shadow-sm" id="btn-update-post">
                                        <span class="spinner-border spinner-border-sm d-none mr-1" role="status" aria-hidden="true"></span>
                                        ${Resource.msg('button.form.save', 'externalApi', null)}
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </isif>
            </div>
        </div>
    </div>
</isdecorate>
