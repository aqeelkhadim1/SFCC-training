<isif condition="${pdict.products && pdict.products.length > 0}">
    <section class="container recently-viewed-section homepage my-4" aria-label="${Resource.msg('heading.recently.viewed', 'recentlyViewed', null)}">
        <div class="mb-3">
            <h2 class="h4 font-weight-bold text-dark mb-1">
                ${Resource.msg('heading.recently.viewed', 'recentlyViewed', null)}
            </h2>
            <p class="text-muted small mb-0">
                ${Resource.msg('subheading.recently.viewed', 'recentlyViewed', null)}
            </p>
        </div>

        <div id="recentlyViewedCarousel" class="carousel slide rv-carousel-wrapper" data-bs-interval="false" data-bs-wrap="false">
            <div class="carousel-inner">
                <isloop items="${pdict.slides}" var="slideItems" status="slideStatus">
                    <div class="carousel-item ${slideStatus.first ? 'active' : ''}">
                        <div class="row recently-viewed-grid">
                            <isloop items="${slideItems}" var="item">
                                <div class="col-6 col-md-4 col-lg-3 mb-2">
                                    <div class="recently-viewed-card card shadow-sm border-0">
                                        <div class="card-body p-2">
                                            <isprint value="${item.tileHtml}" encoding="off" />

                                            <div class="rv-availability mt-2 pt-2 border-top">
                                                <isif condition="${item.availability && item.availability.inStock}">
                                                    <span class="badge bg-success text-white px-2 py-1">
                                                        ${item.availability.label}
                                                    </span>
                                                <iselse/>
                                                    <span class="badge bg-danger text-white px-2 py-1">
                                                        ${item.availability.label}
                                                    </span>
                                                </isif>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </isloop>
                        </div>
                    </div>
                </isloop>
            </div>

            <isif condition="${pdict.slides && pdict.slides.length > 1}">
                <button type="button" class="btn btn-light border shadow-sm rv-slider-btn rv-slider-prev"
                    data-bs-target="#recentlyViewedCarousel" data-bs-slide="prev" disabled="disabled"
                    aria-label="${Resource.msg('button.previous', 'common', null)}">
                    <i class="fa fa-chevron-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-light border shadow-sm rv-slider-btn rv-slider-next"
                    data-bs-target="#recentlyViewedCarousel" data-bs-slide="next"
                    aria-label="${Resource.msg('button.next', 'common', null)}">
                    <i class="fa fa-chevron-right" aria-hidden="true"></i>
                </button>

                <div class="carousel-indicators rv-carousel-indicators">
                    <isloop items="${pdict.slides}" var="dotSlide" status="dotStatus">
                        <button type="button" data-bs-target="#recentlyViewedCarousel"
                            data-bs-slide-to="${dotStatus.index}"
                            class="${dotStatus.first ? 'active' : ''}"
                            aria-current="${dotStatus.first ? 'true' : 'false'}"
                            aria-label="Slide ${dotStatus.count}"></button>
                    </isloop>
                </div>
            </isif>
        </div>
    </section>
</isif>
