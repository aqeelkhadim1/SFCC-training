<isdecorate template="common/layout/page">

    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>

    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/account/dashboard.css');
        assets.addJs('/js/profile.js');
        assets.addJs('/js/wishlist.js');
    </isscript>
    <isinclude template="components/modules" />

    <div class="st-account">
        <div class="container">
            <!---Breadcrumbs--->
            <isinclude template="components/breadcrumbs/pageBreadcrumbs"/>
            <div class="st-account__header">
                <h1 class="st-account__page-title text-center">${Resource.msg('page.heading.dashboard','account',null)}</h1>
            </div>
            <div class="c-account">
                <isinclude template="account/dashboardProfileCards"/>
            </div>

            <isrecommendations aid="account-landing-recommendations"/>
        </div>
    </div>

    <div class="hero slant-down account-image">
        <h1 class="page-title">${Resource.msg('page.heading.dashboard','account',null)}</h1>
    </div>

    <div class="container">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs"/>
        <isinclude template="account/dashboardProfileCards"/>
    </div>
</isdecorate>